# =============================================================================
# Philippine Accounting System (PHA) — Environment Template
# =============================================================================
# Copy to `.env` and fill in. Production secrets come from Vault / Secrets
# Manager and are NEVER committed.
#
# `Mypass123` and `sslmode=disable` are DEV-ONLY. Rotate immediately for any
# non-local deployment and switch to TLS.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME="Philippine Accounting System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=debug

# --- Database (PostgreSQL 16) -----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=accountingdb
DB_USERNAME=postgres
DB_PASSWORD=Mypass123
DB_SSLMODE=disable
DB_CHARSET=utf8
DB_SCHEMA=public,identity,accounting,sales,inventory,procurement,payroll,hr,projects,manufacturing,tax,reporting,audit

# Alternative DSN form (Laravel 11 supports DATABASE_URL):
# DATABASE_URL=postgresql://postgres:Mypass123@localhost:5432/accountingdb?sslmode=disable

# Read replica (Reporting module)
DB_READ_HOST=localhost
DB_READ_USERNAME=pha_reader
DB_READ_PASSWORD=

# --- Redis ------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# Compatibility mirrors
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379

# --- Cache / Queue / Session ------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=reverb

# --- Horizon ----------------------------------------------------------------
HORIZON_PREFIX=pha:horizon:
HORIZON_DOMAIN=

# --- Reverb (websockets) ----------------------------------------------------
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Storage (MinIO in dev, S3 in prod) -------------------------------------
FILESYSTEM_DISK=minio

MINIO_ENDPOINT=http://localhost:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=pha-documents
MINIO_REGION=ph-1
MINIO_USE_PATH_STYLE=true

# --- Mail (Mailpit in dev) --------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@pha.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Authentication ---------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1
SESSION_DOMAIN=localhost
SPA_URL=http://localhost:5173
MFA_ISSUER="Philippine Accounting System"

# --- BIR Compliance ---------------------------------------------------------
BIR_TIN=000-000-000-000
BIR_RDO_CODE=039
BIR_TAXPAYER_TYPE=large
BIR_CAS_PTU_NUMBER=
BIR_CAS_PTU_DATE=

# EIS (e-Invoicing System)
BIR_EIS_ENABLED=false
BIR_EIS_BASE_URL=https://eis-sandbox.bir.gov.ph
BIR_EIS_ISSUANCE_PATH=/api/v1/invoices
BIR_EIS_CLIENT_ID=
BIR_EIS_CLIENT_SECRET=
BIR_EIS_BEARER_TOKEN=
BIR_EIS_CERT_PATH=storage/certs/eis-signing.p12
BIR_EIS_CERT_PASSPHRASE=
BIR_EIS_TIMEOUT=30
BIR_EIS_RETRY_MAX_HOURS=24

BIR_EBIRFORMS_OUTPUT_PATH=storage/app/bir/ebirforms

# --- BSP FX rates -----------------------------------------------------------
BSP_FX_URL=https://www.bsp.gov.ph/statistics/sdds/exchrate.htm
BSP_FX_SCHEDULE="0 9 * * 1-5"

# --- Statutory rate table versions ------------------------------------------
SSS_RATE_TABLE_VERSION=2026-01
PHILHEALTH_RATE_VERSION=2026-01
PAGIBIG_RATE_VERSION=2026-01
BIR_TAX_TABLE_VERSION=2026-01

# --- SMS (Semaphore) --------------------------------------------------------
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PHA

# --- Observability ----------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PULSE_ENABLED=true
TELESCOPE_ENABLED=true

# --- Vite / Frontend --------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api/v1

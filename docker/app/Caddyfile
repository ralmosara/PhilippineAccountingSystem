# =============================================================================
# FrankenPHP Caddyfile for Octane
# =============================================================================
# Routes all HTTP traffic to the Octane worker pool. TLS is terminated upstream
# (Nginx/Traefik in prod); in dev we serve plain HTTP on :8000.
# =============================================================================

{
	# Global options
	frankenphp
	order php_server before file_server
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8000 {
	root * /app/public

	encode zstd gzip

	# Health endpoint (cheap; returns 200 from Laravel's `/up`)
	handle /up {
		php_server
	}

	# Static assets
	@static {
		path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.woff *.woff2 *.ttf *.eot
	}
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else → Octane via FrankenPHP
	handle {
		php_server {
			worker /app/public/frankenphp-worker.php
		}
	}

	# Logging
	log {
		output stdout
		format json
	}
}

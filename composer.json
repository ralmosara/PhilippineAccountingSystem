{
    "name": "pha/philippine-accounting-system",
    "type": "project",
    "description": "Philippine Accounting System — full BIR-compliant ERP/Accounting (CAS + EIS ready). Laravel 11 + PostgreSQL 16 + React 18.",
    "keywords": ["laravel", "accounting", "bir", "philippines", "erp", "cas", "eis"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",

        "laravel/framework": "^11.31",
        "laravel/sanctum": "^4.0",
        "laravel/horizon": "^5.27",
        "laravel/octane": "^2.5",
        "laravel/pulse": "^1.2",
        "laravel/reverb": "^1.4",
        "laravel/tinker": "^2.9",

        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-medialibrary": "^11.10",
        "spatie/laravel-data": "^4.11",
        "spatie/laravel-backup": "^9.2",
        "spatie/browsershot": "^5.0",

        "barryvdh/laravel-dompdf": "^3.1",
        "maatwebsite/excel": "^3.1",
        "league/csv": "^9.16",
        "league/flysystem-aws-s3-v3": "^3.0",

        "pragmarx/google2fa-laravel": "^2.2",
        "bacon/bacon-qr-code": "^3.0",
        "guzzlehttp/guzzle": "^7.9",
        "ramsey/uuid": "^4.7",
        "predis/predis": "^2.2",
        "sentry/sentry-laravel": "^4.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.4",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpunit/phpunit": "^11.4",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Modules\\": "app/Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "test": "@php artisan test --parallel",
        "test:coverage": "@php artisan test --coverage --min=80",
        "test:types": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test:style": "vendor/bin/pint --test",
        "fix:style": "vendor/bin/pint",
        "ci": [
            "@test:style",
            "@test:types",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
